# ──────────────────────────────────────────────────────────────────────────────
# PRODUCER LEADS — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   1. Copy this file and rename the copy to  .env
#   2. Fill in your values below
#   3. NEVER commit .env to GitHub — it contains secret keys
#
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── Threads API ───────────────────────────────────────────────────────────────
# Your personal long-lived access token (expires every 60 days, needs renewal).
# How to get it: see SETUP_GUIDE.md → Step 3
EXPO_PUBLIC_THREADS_ACCESS_TOKEN=YOUR_THREADS_TOKEN_HERE
